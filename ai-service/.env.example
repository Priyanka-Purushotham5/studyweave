# Copy to .env (git-ignored). Never commit a real key.
GEMINI_API_KEY=
# 1 = serve fixtures/ai_raw instead of calling Gemini (no key needed)
FAKE_GEMINI=1
# Text model and fallbacks (tried in order when one is overloaded, rate-limited or not served).
# python -m eval.probe_models shows which answer right now.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
# Seconds per attempt, and for all fallbacks together (Module B waits 60 s per call)
GEMINI_TIMEOUT=40
GEMINI_DEADLINE=55
# Live checks are opt-in: RUN_LIVE_GEMINI_TESTS=1 pytest -m live
