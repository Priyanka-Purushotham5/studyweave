{$DOMAIN} {
    basic_auth {
        {$API_USERNAME} {$API_PASSWORD_HASH}
    }
    encode zstd gzip
    request_body {
        max_size 28MB
    }
    @backend path /api/* /healthz /readyz
    handle @backend {
        reverse_proxy api:3000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
