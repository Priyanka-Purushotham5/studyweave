DOMAIN=studyweave.example.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/studyweave
MONGODB_DB=studyweave
AI_MODE=http
AI_SERVICE_IMAGE=studyweave-ai-service:demo
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# AI_SERVICE_URL is fixed to http://ai-service:8000 by Compose.
CORS_ORIGIN=https://studyweave.example.com
VECTOR_MODE=cosine

API_USERNAME=danush
# Generate with: docker run --rm caddy:2-alpine caddy hash-password
API_PASSWORD_HASH=REPLACE_WITH_CADDY_PASSWORD_HASH
