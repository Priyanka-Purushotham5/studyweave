DOMAIN=studynova.example.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/studyweave
MONGODB_DB=studyweave
AI_MODE=http
AI_SERVICE_IMAGE=studyweave-ai-service:demo
FAKE_GEMINI=1
# Set FAKE_GEMINI=0 and a real key only when ready for live model calls.
GEMINI_API_KEY=
# AI_SERVICE_URL is fixed to http://ai-service:8001 by Compose.
CORS_ORIGIN=https://studynova.example.com
VECTOR_MODE=cosine

API_USERNAME=danush
# Generate with: docker run --rm caddy:2-alpine caddy hash-password
API_PASSWORD_HASH=REPLACE_WITH_CADDY_PASSWORD_HASH

# Preserve the team convention unless a collision policy is approved.
CONCEPT_ID_COLLISIONS=reject
