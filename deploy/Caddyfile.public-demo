{$DOMAIN} {
    encode zstd gzip
    @reads {
        method GET
        path /api/tree /api/graph /healthz /readyz
    }
    @interactions {
        method POST
        path /api/questions/next /api/attempts
    }
    route {
        reverse_proxy @reads api:3000
        reverse_proxy @interactions api:3000
        @blocked path /api /api/* /healthz /readyz
        respond @blocked 404
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
